# Copy to .env next to docker-compose.prod.yml and fill in. Names only — never commit values.
# chmod 600 .env

# --- required: database (mysql container + api) ---
DB_ROOT_PASSWORD=
DB_NAME=
DB_USERNAME=
DB_PASSWORD=

# --- required: api (see src/main/resources/application.yaml) ---
JWT_SECRET=
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
OAUTH2_REDIRECT_URL=

# --- required: caddy ---
# public hostname of the API (DNS A record -> this box)
API_DOMAIN=

# Optional names stay COMMENTED OUT unless given a value: an empty value is passed to the
# api as an empty string (e.g. CORS_ALLOWED_ORIGINS= would disable every origin).

# --- optional: api (application.yaml has production defaults) ---
# OAUTH2_ALLOWED_REDIRECT_ORIGINS=
# CORS_ALLOWED_ORIGINS=
# SHOW_SQL=
# API_DOCS_ENABLED=

# --- optional: stack tuning (defaults in docker-compose.prod.yml) ---
# health endpoint used by the api healthcheck; /health-check for images without actuator
# API_HEALTH_PATH=
# API_MEM_LIMIT=
# MYSQL_MEM_LIMIT=
# CADDY_MEM_LIMIT=
# MYSQL_INNODB_BUFFER_POOL_SIZE=
# MYSQL_MAX_CONNECTIONS=
# MYSQL_IMAGE_TAG=
# CADDY_IMAGE_TAG=

# --- optional: volume names — set to the EXISTING volumes when adopting a running box ---
# MYSQL_VOLUME=
# CADDY_DATA_VOLUME=
# CADDY_CONFIG_VOLUME=

# NOTE: KORDI_API_TAG is NOT set here. deploy.sh records the running tag in .state/release.env.
